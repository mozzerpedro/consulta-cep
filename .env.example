PORT=3000
VIACEP_BASE_URL=https://viacep.com.br/ws
VIACEP_TIMEOUT_MS=5000

# Cache: se o Redis estiver fora, a API continua funcionando direto pelo ViaCEP.
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
REDIS_KEY_PREFIX=cep:
# Teto de espera por operação de cache, para o Redis nunca segurar a request.
REDIS_TIMEOUT_MS=1000
# Validade de cada CEP cacheado, em segundos (86400 = 24h).
REDIS_TTL_SECONDS=86400
